{
  "name": "diktor-konspektov",
  "private": true,
  "description": "Мобильное PWA: диктует конспекты голосом, отвечает на вопросы через нейросеть и продолжает с того же места",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "node tests/serve.mjs",
    "test": "node tests/run.mjs",
    "quality:list": "node tests/quality/evaluate.mjs --list",
    "quality:check": "node tests/quality/evaluate.mjs",
    "test:quality": "node tests/quality/evaluate.mjs --self-test"
  },
  "devDependencies": {
    "lamejs": "^1.2.1",
    "playwright": "1.56.1"
  }
}
